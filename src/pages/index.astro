---
// Корень уводит на язык по умолчанию. Astro не создаёт этот редирект сам,
// потому что включён prefixDefaultLocale.
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/site/ru/" />
    <link rel="canonical" href="/site/ru/" />
    <title>Клавдия — документация</title>
  </head>
  <body>
    <p><a href="/site/ru/">Документация Клавдии</a></p>
  </body>
</html>