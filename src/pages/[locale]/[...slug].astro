---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import ElementCard from '../../components/ElementCard.astro';
import { localeOf, pathOf } from '../../lib/nav';
import { coerceLocale } from '../../lib/url';
import { orderOf } from '../../lib/toc';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((entry) => ({
    params: { locale: localeOf(entry.id), slug: pathOf(entry.id) || undefined },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const locale = coerceLocale(Astro.params.locale ?? 'ru');
const path = pathOf(entry.id);
const entries = await getCollection('docs', ({ data }) => !data.draft);
const ordered = orderOf(entries, locale);
const index = ordered.findIndex((p) => p.path === path);
const prev = index > 0 ? ordered[index - 1] : undefined;
const next = index >= 0 && index < ordered.length - 1 ? ordered[index + 1] : undefined;
const titles = Object.fromEntries(ordered.map((p) => [p.path, p.title]));
// Корневая страница раздела — самая неглубокая в нём. У «Знакомства» это сам
// корень языка: отдельной страницы-лендинга у раздела нет.
const sectionRoot =
  ordered
    .filter((p) => p.section === entry.data.section)
    .map((p) => p.path)
    .sort(
      (a, b) =>
        a.split('/').filter(Boolean).length - b.split('/').filter(Boolean).length ||
        a.localeCompare(b),
    )[0] ?? '';

const elements = entry.data.elements;

// render(entry) в Astro 7 возвращает и Content, и список заголовков.
const { Content, headings } = await render(entry);
const tocHeadings = headings.map((h) => ({ id: h.slug, text: h.text, depth: h.depth }));
---

<DocLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  section={entry.data.section}
  path={path}
  entries={entries}
  headings={tocHeadings}
  prev={prev}
  next={next}
  titles={titles}
  sectionRoot={sectionRoot}
>
  <Content />

  {elements.length > 0 && (
    <div class="cards">
      {elements.map((card) => (
        <ElementCard locale={locale} card={card} />
      ))}
    </div>
  )}
</DocLayout>