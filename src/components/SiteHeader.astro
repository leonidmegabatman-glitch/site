---
import { t } from '../lib/i18n';
import { href } from '../lib/url';

interface Props { locale: 'ru' | 'en' }
const { locale } = Astro.props;
---

<header class="site-header">
  <a class="brand" href={href(locale)}>
    <img src={`${import.meta.env.BASE_URL}icon.png`} alt="" width="24" height="24" />
    <span>Клавдия</span>
  </a>
  <nav class="site-header__nav">
    <button type="button" class="search-open" data-search-open>
      {t(locale, 'search')} <kbd>Ctrl K</kbd>
    </button>
    <slot name="header-extra" />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 56px;
    padding: 0 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-raised);
    position: sticky;
    top: 0;
    z-index: 20;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 600;
  }
  .brand:hover { text-decoration: none; }
  .site-header__nav { margin-left: auto; display: flex; align-items: center; gap: 0.5rem; }
  .search-open {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-inset);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    font: inherit;
  }
</style>