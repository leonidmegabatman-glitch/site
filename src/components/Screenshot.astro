---
import { Image } from 'astro:assets';
import { t, type Locale } from '../lib/i18n';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  highlight?: { x: number; y: number; w: number; h: number };
  locale?: Locale;
}

const { src, alt, caption, highlight, locale = 'ru' } = Astro.props;

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/**/*.png', { eager: true });
const key = `../assets/screenshots/${src}`;
const mod = shots[key];
---

{
  mod ? (
    <figure class="shot">
      <div class="shot__frame">
        <Image
          src={mod.default}
          alt={alt}
          widths={[640, 1024, 1600]}
          sizes="(max-width: 900px) 100vw, 720px"
          loading="lazy"
        />
        {highlight && (
          <span
            class="shot__highlight"
            style={`left:${highlight.x * 100}%;top:${highlight.y * 100}%;width:${highlight.w * 100}%;height:${highlight.h * 100}%`}
          />
        )}
      </div>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  ) : (
    <figure class="shot shot--missing">
      <div class="shot__frame shot__frame--missing">
        <span class="shot__badge">{t(locale, 'screenshotNeeded')}</span>
        <p class="shot__desc">{alt}</p>
        <code>{src}</code>
      </div>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .shot { margin: 1.2rem 0 0; }
  .shot__frame {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-inset);
  }
  .shot__frame :global(img) { display: block; width: 100%; height: auto; }
  .shot__highlight {
    position: absolute;
    border: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .shot__frame--missing {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-style: dashed;
  }
  .shot__badge {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .shot__desc { margin: 0; color: var(--fg-muted); font-size: 0.9rem; }
  .shot figcaption { margin-top: 0.4rem; color: var(--fg-muted); font-size: 0.85rem; }
</style>