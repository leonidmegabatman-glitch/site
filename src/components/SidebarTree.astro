---
import { SECTIONS, sectionTitle } from '../lib/nav';
import { buildTree } from '../lib/toc';
import Tree from './Tree.astro';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  entries: { id: string; data: any }[];
  currentPath: string;
}
const { locale, entries, currentPath } = Astro.props;
const tree = buildTree(entries, locale);

const sectionOf = (path: string) => path.split('/')[0];
const isActive = (path: string) => path === currentPath;
const isOnPath = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<nav class="tree" aria-label={locale === 'ru' ? 'Разделы документации' : 'Documentation sections'}>
  {
    SECTIONS.map((section) => {
      const nodes = tree.filter((n) => sectionOf(n.path) === section.id);
      if (nodes.length === 0) return null;
      return (
        <div class="tree__section">
          <div class="tree__section-title">{sectionTitle(section.id, locale)}</div>
          <Tree nodes={nodes} locale={locale} isActive={isActive} isOnPath={isOnPath} />
        </div>
      );
    })
  }
</nav>

<script is:inline>
  // Держим активный пункт дерева в зоне видимости.
  const active = document.querySelector('[data-tree] [aria-current="page"]');
  if (active) active.scrollIntoView({ block: 'nearest' });
</script>

<style>
  .tree { padding: 1rem 0.5rem 2rem; }
  .tree__section { margin-bottom: 1.25rem; }
  .tree__section-title {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
    padding: 0 0.5rem 0.35rem;
  }
</style>