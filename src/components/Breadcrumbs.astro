---
import { SECTIONS, sectionTitle, type SectionId } from '../lib/nav';
import { href } from '../lib/url';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  section: SectionId;
  path: string;
  title: string;
  titles?: Record<string, string>;
  /** Путь корневой страницы раздела; пустая строка — корень языка. */
  sectionRoot?: string;
}
const { locale, section, path, title, titles = {}, sectionRoot = '' } = Astro.props;
// Корень языка сам служит корневой страницей «Знакомства» — отдельной ссылки на него не нужно.
const atRoot = path === '';
const atSectionRoot = path === sectionRoot;
// Первый сегмент пути — сам раздел; пустые сегменты (корень) отбрасываются.
const segments = path.split('/').filter(Boolean).slice(1);
const crumbs = segments.map((_, index) => {
  const sub = segments.slice(0, index + 1).join('/');
  const full = `${section}/${sub}`;
  return { path: full, label: titles[full] ?? sub.split('-').join(' ') };
});
---

<nav class="crumbs" aria-label="breadcrumbs">
  {
    !atRoot && (
      <>
        <a href={href(locale)}>Клавдия</a>
        {!atSectionRoot && <span aria-hidden="true">/</span>}
      </>
    )
  }
  {
    atSectionRoot ? (
      <span aria-current="page">{sectionTitle(section, locale)}</span>
    ) : (
      <a href={href(locale, sectionRoot)}>{sectionTitle(section, locale)}</a>
    )
  }
  {
    crumbs.map((crumb, index) => (
      <>
        <span aria-hidden="true">/</span>
        {index === crumbs.length - 1 ? (
          <span aria-current="page">{title}</span>
        ) : (
          <a href={href(locale, crumb.path)}>{crumb.label}</a>
        )}
      </>
    ))
  }
</nav>

<style>
  .crumbs { font-size: 0.85rem; color: var(--fg-muted); display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .crumbs span[aria-current] { color: var(--fg); }
</style>