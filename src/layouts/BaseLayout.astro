---
import '../styles/global.css';
import '../styles/search.css';
import SiteHeader from '../components/SiteHeader.astro';
import Search from '../components/Search.astro';

interface Props {
  locale: 'ru' | 'en';
  title: string;
  description?: string;
}

const { locale, title, description = '' } = Astro.props;
const fullTitle = `${title} — Клавдия`;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <script is:inline>
      // Тема до первой отрисовки, чтобы не мигало.
      try {
        const saved = localStorage.getItem('klavdiya-site-theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <span data-pagefind-filter="locale" hidden>{locale}</span>
    <SiteHeader locale={locale} path={Astro.url.pathname.replace(`${import.meta.env.BASE_URL}${locale}/`, '').replace(/\/$/, '')} />
    <slot />
    <footer class="site-footer">
      <div class="site-footer__inner">
        <span>{locale === 'ru' ? 'Документация для 0.6.0' : 'Documentation for 0.6.0'}</span>
        <span class="site-footer__sep">·</span>
        <a href="https://github.com/leonidmegabatman-glitch/site">{locale === 'ru' ? 'Исходники на GitHub' : 'Source on GitHub'}</a>
        <span class="site-footer__sep">·</span>
        <span>AGPL-3.0</span>
      </div>
    </footer>
    <Search locale={locale} />
  </body>
</html>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--fg-muted);
  }
  .site-footer__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .site-footer__sep {
    opacity: 0.5;
  }
  .site-footer a {
    color: var(--fg-muted);
  }
  .site-footer a:hover {
    color: var(--accent);
  }
</style>